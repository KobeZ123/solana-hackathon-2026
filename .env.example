# Copy to .env.local. Everything here is optional for local dev (a JSON-file store is used
# when Supabase vars are absent and a dev JWT secret is used with a console warning).

# Program id (client + server). Defaults to the fixed id below.
NEXT_PUBLIC_PROGRAM_ID=E4SJunPXu5ZyoiSpz9Nk4jUAQWjj7qif6fTBDjR1Ping

# Server-side RPC used to read Event/Ticket accounts (default: public devnet).
SOLANA_RPC_URL=https://api.devnet.solana.com

# HS256 secret for session JWTs. REQUIRED in production (the server refuses to sign
# without it when NODE_ENV=production). Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Supabase (server only, service role; never expose to the browser). When BOTH are set the
# API uses Supabase, otherwise the JSON-file store below. Provisioning is manual: create a
# project, then run supabase/migrations/0001_init.sql in the SQL editor (or `supabase db push`).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# JSON-file store location when Supabase is not configured (default .data/store.json, gitignored).
STORE_FILE=

# Stretch B: shared secret protecting POST /api/index/refresh.
CRON_SECRET=
